# Copy to .env and adjust. Load it into your shell before running, e.g.:
#   export $(grep -v '^#' .env | xargs)
#   go run ./cmd/api

# HTTP port the server listens on.
PORT=8080

# "development" or "production" (affects logging/health output only).
ENV=development

# PostgreSQL connection string (DSN).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hnews?sslmode=disable

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Access-token lifetime. Accepts a Go duration ("24h", "30m") or seconds.
JWT_TTL=24h
